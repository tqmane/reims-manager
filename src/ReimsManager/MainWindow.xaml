<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReimsManager" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="ReimsManager.MainWindow" Title="Reims Manager" Width="1380" Height="880" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable, Yu Gothic UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="WindowKeyDown" StateChanged="WindowStateChanged" WindowStyle="SingleBorderWindow">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- These styles are local to the workstation; setup dialogs keep their native Fluent styles. -->
    <Style x:Key="CommandButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CommandIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="DeviceIcon" TargetType="TextBlock" BasedOn="{StaticResource CommandIcon}">
      <Setter Property="Width" Value="28"/>
    </Style>
    <Style x:Key="WorkspaceTab" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="TabSurface" Background="Transparent" CornerRadius="6,6,0,0" BorderBrush="Transparent" BorderThickness="1"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <Border x:Name="TabIndicator" Height="3" Margin="14,0" VerticalAlignment="Bottom" Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" CornerRadius="2" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource ItemHoverBackground}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource CardBackground}"/>
                <Setter TargetName="TabIndicator" Property="Visibility" Value="Visible"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DeviceItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavigationItem}">
      <Setter Property="Padding" Value="10,10"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style x:Key="WorkspaceNotice" TargetType="Border" BasedOn="{StaticResource NoticeCard}">
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>
  <Border x:Name="ChromeRoot" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
    <Grid x:Name="AppLayout" Background="{DynamicResource ApplicationBackgroundBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border x:Name="TitleBar" Grid.Row="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="SessionCommands" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,8,0">
            <Button x:Name="LibraryCommand" Content="" Click="ShowLibrary" Style="{StaticResource ChromeButton}" ToolTip="ライブラリに戻る（VMは実行を続けます）" AutomationProperties.Name="ライブラリに戻る"/>
            <Button x:Name="SessionPowerButton" Content="" Click="ShowPowerMenu" Style="{StaticResource ChromeButton}" ToolTip="VMの電源操作" AutomationProperties.Name="VMの電源操作">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="シャットダウン" Tag="PowerOff" Click="MenuAction"/>
                  <MenuItem Header="完全終了" Tag="Exit" Click="MenuAction"/>
                  <Separator/>
                  <MenuItem Header="強制終了…" Tag="ForceExit" Click="ForceExit"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button x:Name="SessionPauseButton" Content="" Tag="Pause" Click="ActionClick" Style="{StaticResource ChromeButton}" ToolTip="一時停止" AutomationProperties.Name="一時停止"/>
            <Button x:Name="SessionRestartButton" Content="" Tag="Restart" Click="ActionClick" Style="{StaticResource ChromeButton}" ToolTip="macOSを再起動" AutomationProperties.Name="macOSを再起動"/>
            <Border Width="1" Margin="6,9" Background="{DynamicResource CardBorderBrush}"/>
            <Button x:Name="SessionSettingsButton" Content="" Click="OpenSettings" Style="{StaticResource ChromeButton}" ToolTip="仮想マシンの設定" AutomationProperties.Name="仮想マシンの設定"/>
            <Button x:Name="SessionUsbButton" Content="" Tag="usb" Click="OpenSettingsCategory" Style="{StaticResource ChromeButton}" ToolTip="USBデバイス" AutomationProperties.Name="USBデバイス"/>
            <Button x:Name="SessionSharingButton" Content="" Tag="2" Click="NavigatePage" Style="{StaticResource ChromeButton}" ToolTip="クリップボード共有" AutomationProperties.Name="クリップボード共有"/>
            <Button x:Name="SessionSnapshotButton" Content="" Tag="4" Click="NavigatePage" Style="{StaticResource ChromeButton}" ToolTip="スナップショット" AutomationProperties.Name="スナップショット"/>
            <Button x:Name="SessionPopOutButton" Content="" Click="PopOutConsole" Style="{StaticResource ChromeButton}" ToolTip="VM画面を別ウィンドウで開く" AutomationProperties.Name="VM画面を別ウィンドウで開く"/>
          </StackPanel>
          <StackPanel x:Name="ApplicationBrand" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
            <TextBlock Text="" Style="{StaticResource CommandIcon}" Margin="0,0,10,0"/>
            <TextBlock Text="Reims Manager" FontWeight="SemiBold" TextWrapping="NoWrap"/>
          </StackPanel>
          <TextBlock x:Name="SessionTitle" Grid.Column="1" Text="{Binding Text, ElementName=VmTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="12,0" FontSize="12" ToolTip="入力をWindowsに戻す: Ctrl + Alt + Win"/>
          <StackPanel x:Name="CaptionCommands" Grid.Column="2" Orientation="Horizontal">
            <Button x:Name="MinimizeCommand" Content="" Click="MinimizeWindow" Style="{StaticResource CaptionButton}" ToolTip="最小化" AutomationProperties.Name="最小化"/>
            <Button x:Name="MaximizeCommand" Content="" Click="MaximizeWindow" Style="{StaticResource CaptionButton}" ToolTip="最大化 / 元に戻す" AutomationProperties.Name="最大化または元に戻す"/>
            <Button x:Name="CloseCommand" Content="" Click="CloseWindow" Style="{StaticResource CaptionButton}" ToolTip="ウィンドウを閉じる（VMは終了しません）" AutomationProperties.Name="ウィンドウを閉じる"/>
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel x:Name="GlobalNotices" Grid.Row="1" Margin="12,0">
        <TextBlock x:Name="StatusDetail" Margin="4,0,4,10" MaxHeight="54" TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
              <Style.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <StackPanel x:Name="OperationProgress" Visibility="Collapsed" Margin="4,0,4,10">
          <TextBlock x:Name="OperationStatus" Text="処理しています…" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
          <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True"/>
        </StackPanel>
        <Border x:Name="EngineNotice" Style="{StaticResource WorkspaceNotice}">
          <DockPanel>
            <Button Content="セットアップ…" Click="SetupEngine" DockPanel.Dock="Right" Margin="16,0,0,0"/>
            <StackPanel>
              <TextBlock Text="Reims エンジンを設定" FontWeight="SemiBold"/>
              <TextBlock Text="最初に一度だけ必要です。設定後に VM を作成・起動できます。" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border x:Name="Feedback" Visibility="Collapsed" Style="{StaticResource WorkspaceNotice}">
          <DockPanel>
            <Button Content="閉じる" Click="DismissError" DockPanel.Dock="Right" Margin="16,0,0,0"/>
            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="ErrorNotice" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </StackPanel>
      <StackPanel x:Name="ManagementCommands" Grid.Row="2">
        <Menu Padding="12,2" Background="Transparent">
          <MenuItem Header="ファイル">
            <MenuItem Header="新しい仮想マシン…" InputGestureText="Ctrl+N" Click="NewVm"/>
            <MenuItem Header="仮想マシンを開く…" InputGestureText="Ctrl+O" Click="OpenVm"/>
            <MenuItem Header="既存のディスクを取り込む…" Click="ImportVm"/>
            <Separator/>
            <MenuItem Header="VM の保存先を開く" Click="RevealVm"/>
          </MenuItem>
          <MenuItem Header="仮想マシン">
            <MenuItem x:Name="MenuStart" Header="起動" Tag="Start" Click="MenuAction"/>
            <MenuItem x:Name="MenuPowerOff" Header="シャットダウン" Tag="PowerOff" Click="MenuAction"/>
            <MenuItem x:Name="MenuRestart" Header="再起動" Tag="Restart" Click="MenuAction"/>
            <Separator/>
            <MenuItem x:Name="MenuForceExit" Header="強制終了…" Click="ForceExit"/>
          </MenuItem>
          <MenuItem Header="表示">
            <MenuItem Header="状態を更新" InputGestureText="F5" Click="RefreshClick"/>
            <MenuItem Header="VM 画面を別ウィンドウにする" Click="PopOutConsole"/>
            <MenuItem Header="VM 画面をアプリに戻す" Click="DockConsole"/>
          </MenuItem>
        </Menu>
        <Border x:Name="CommandBar" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,5,12,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="NewVmCommand" IsEnabled="{Binding IsEnabled, ElementName=Library}" Click="NewVm" Style="{StaticResource CommandButton}" ToolTip="新しい仮想マシン (Ctrl+N)" AutomationProperties.Name="新しい仮想マシン">
                <TextBlock Text="" Style="{StaticResource CommandIcon}"/>
              </Button>
              <Button IsEnabled="{Binding IsEnabled, ElementName=Library}" Click="OpenVm" Style="{StaticResource CommandButton}" ToolTip="仮想マシンを開く (Ctrl+O)" AutomationProperties.Name="仮想マシンを開く">
                <TextBlock Text="" Style="{StaticResource CommandIcon}"/>
              </Button>
              <Border Width="1" Background="{DynamicResource CardBorderBrush}" Margin="10,6"/>
              <Button x:Name="StartButton" Content="▶  起動" Tag="Start" Click="ActionClick" Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="2,0,6,0" MinHeight="34"/>
              <Button x:Name="ResumeButton" Content="▶  再開" Tag="Resume" Click="ActionClick" Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="2,0,6,0" MinHeight="34" Visibility="Collapsed"/>
              <Button x:Name="PowerOffButton" Tag="PowerOff" Click="ActionClick" Style="{StaticResource CommandButton}" AutomationProperties.Name="シャットダウン">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" Style="{StaticResource CommandIcon}" Margin="0,0,8,0"/>
                  <TextBlock Text="シャットダウン" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="RestartButton" Tag="Restart" Click="ActionClick" Style="{StaticResource CommandButton}" ToolTip="macOS を再起動" AutomationProperties.Name="再起動">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" Style="{StaticResource CommandIcon}" Margin="0,0,8,0"/>
                  <TextBlock Text="再起動" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="PowerMoreButton" Content="" FontFamily="Segoe Fluent Icons" FontSize="16" Style="{StaticResource CommandButton}" ToolTip="一時停止・完全終了など" AutomationProperties.Name="その他の電源操作" Click="ShowPowerMenu">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="完全終了（設定変更前）" Tag="Exit" Click="MenuAction"/>
                    <MenuItem Header="一時停止" Tag="Pause" Click="MenuAction"/>
                    <MenuItem Header="再開" Tag="Resume" Click="MenuAction"/>
                    <Separator/>
                    <MenuItem Header="強制終了…" Tag="ForceExit" Click="ForceExit"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Border Width="1" Background="{DynamicResource CardBorderBrush}" Margin="10,6"/>
              <Button x:Name="ConsoleCommand" Click="DockConsole" Style="{StaticResource CommandButton}" IsEnabled="{Binding IsEnabled, ElementName=ConsoleConnectButton}" ToolTip="コンソールに切り替えて接続" AutomationProperties.Name="コンソールに接続">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" Style="{StaticResource CommandIcon}" Margin="0,0,8,0"/>
                  <TextBlock Text="コンソール" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="2" Click="RefreshClick" Style="{StaticResource CommandButton}" ToolTip="状態を更新 (F5)" AutomationProperties.Name="状態を更新">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" Style="{StaticResource CommandIcon}" Margin="0,0,8,0"/>
                <TextBlock Text="更新" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </StackPanel>
      <Grid Grid.Row="3" x:Name="WorkstationLayout">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="LibraryColumn" Width="236" MinWidth="200" MaxWidth="340"/>
          <ColumnDefinition Width="5"/>
          <ColumnDefinition Width="*" MinWidth="630"/>
        </Grid.ColumnDefinitions>
        <Border Padding="12,16,10,12" x:Name="LibraryPane">
          <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="SidebarLayout" Height="{Binding ViewportHeight, ElementName=SidebarScroll}" MinHeight="460">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="80"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="8,0,0,18">
                <TextBlock Text="" Style="{StaticResource CommandIcon}" FontSize="24" Margin="0,0,10,0"/>
                <TextBlock Text="Reims" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
              <Grid Grid.Row="1" Margin="8,0,4,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="ライブラリ" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Items.Count, ElementName=Library}" Style="{StaticResource MutedText}" VerticalAlignment="Center" AutomationProperties.Name="表示中の VM 数"/>
              </Grid>
              <StackPanel Grid.Row="2">
                <Grid Margin="0,0,0,16">
                  <TextBox x:Name="LibrarySearch" TextChanged="FilterLibrary" Padding="32,7,10,7" ToolTip="VM の名前で絞り込み" AutomationProperties.Name="仮想マシンを検索"/>
                  <TextBlock Text="" FontFamily="Segoe Fluent Icons" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  <TextBlock Text="VM を検索" IsHitTestVisible="False" Margin="33,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=LibrarySearch}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,8">
                  <TextBlock Text="" Style="{StaticResource CommandIcon}" FontSize="16" Margin="0,0,8,0"/>
                  <TextBlock Text="このコンピューター" Style="{StaticResource MutedText}" FontSize="12"/>
                </StackPanel>
              </StackPanel>
              <Grid Grid.Row="3" Margin="0,0,0,12">
                <ListBox x:Name="Library" BorderThickness="0" Background="Transparent" SelectionChanged="VmChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="仮想マシン一覧" MouseDoubleClick="OpenLibraryConsole">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavigationItem}">
                      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                      <Setter Property="AutomationProperties.HelpText" Value="{Binding Directory}"/>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,3" ToolTip="{Binding File}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="34"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="" Style="{StaticResource CommandIcon}" FontSize="20"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                          <TextBlock x:Name="VmPathLabel" Text="{Binding Subtitle}" ToolTip="{Binding Directory}" FontSize="11" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="LibraryEmpty" Text="「新規」または「開く」から追加" Style="{StaticResource MutedText}" FontSize="12" Margin="10,14" VerticalAlignment="Top" IsHitTestVisible="False"/>
              </Grid>
              <Border Grid.Row="4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" SizeChanged="SidebarSectionsSizeChanged">
                <StackPanel>
                  <Button Content="VM を開く…" Click="OpenVm" Style="{StaticResource CommandButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" ToolTip="Ctrl+O"/>
                  <Button Content="ライブラリを更新" Click="ReloadLibrary" Style="{StaticResource CommandButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" ToolTip="接続し直した保存先や、別のアプリで追加した VM を再確認"/>
                  <Expander x:Name="EngineSettingsExpander" Header="エンジン設定">
                    <StackPanel Margin="0,10,0,0">
                      <TextBlock x:Name="EngineSummary" Text="未設定" Style="{StaticResource MutedText}"/>
                      <TextBox x:Name="Root" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="62" VerticalScrollBarVisibility="Auto" Margin="0,6,0,8" AutomationProperties.Name="エンジンの保存先"/>
                      <Button Content="エンジンをセットアップ…" Click="SetupEngine" Padding="10,8" Margin="0,0,0,6"/>
                      <Button x:Name="SelectExistingEngineButton" Content="既存のエンジンを選択…" Click="BrowseRoot" Padding="10,8" Margin="0"/>
                    </StackPanel>
                  </Expander>
                  <Expander x:Name="PreferencesExpander" Header="登録・保存先" Margin="0,10,0,0">
                    <StackPanel Margin="0,10,0,0">
                      <TextBlock Text="VM の登録とエンジンの保存先はアプリ更新後も保持します。" Style="{StaticResource MutedText}" FontSize="12"/>
                      <TextBox x:Name="PreferencesLocation" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="62" VerticalScrollBarVisibility="Auto" Margin="0,8" AutomationProperties.Name="アプリ設定の保存先"/>
                      <Button Content="設定の保存先を開く" Click="OpenPreferencesFolder" Padding="10,8" Margin="0,0,0,6"/>
                      <Button x:Name="ImportPreferencesButton" Content="以前の設定を取り込む…" Click="ImportPreferences" Padding="10,8" Margin="0" ToolTip="別の設定フォルダーの settings.json から登録を追加。現在の登録は保持します。"/>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </Border>
        <GridSplitter x:Name="LibrarySplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" KeyboardIncrement="8" ToolTip="ドラッグまたは方向キーでライブラリの幅を変更" AutomationProperties.Name="ライブラリの幅を変更"/>
        <Grid Grid.Column="2" Margin="8,14,14,10" x:Name="MainWorkspace">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid x:Name="VmHeader" Margin="4,0,4,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="VmTitle" Text="Reims Manager" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <TextBlock x:Name="VmSummary" Text="仮想マシンを作成するか、ライブラリから選択してください。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,6" VerticalAlignment="Top" Margin="16,2,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" Style="{StaticResource CommandIcon}" FontSize="16" Margin="0,0,7,0"/>
                <TextBlock x:Name="State" Text="未選択" FontSize="12" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
              </StackPanel>
            </Border>
          </Grid>
          <Grid Grid.Row="1" x:Name="WorkspaceNavSection">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="WorkspaceNavigation" ItemContainerStyle="{StaticResource WorkspaceTab}" BorderThickness="0" Background="Transparent" SelectionChanged="NavigationChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="VM のページ">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBoxItem Tag="0" AutomationProperties.Name="VMの概要">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" Style="{StaticResource CommandIcon}" Margin="0,0,8,0"/>
                  <TextBlock Text="概要"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="4" AutomationProperties.Name="スナップショット">
                <StackPanel Orientation="Horizontal">
