                    </StackPanel>
                  </Grid>
                  <WrapPanel Margin="0,20,0,0">
                    <Button Content="識別情報を保存" Click="SaveIdentity" Style="{StaticResource PrimaryButton}" Tag="SetIdentity"/>
                    <Button Content="現在の設定を読み込む" Click="LoadIdentityClick" Tag="GetIdentity"/>
                    <Button Content="新しく生成…" Click="GenerateIdentity" Tag="GenerateIdentity"/>
                  </WrapPanel>
                  <TextBlock Text="OpenCore の起動設定" Style="{StaticResource SectionHeading}"/>
                  <TextBlock Text="起動プロファイルを再適用します。VM の完全終了後に操作してください。" Style="{StaticResource MutedText}"/>
                  <Button x:Name="ApplyBootProfileButton" Content="起動プロファイルを再適用" Tag="ApplyBootProfile" Click="ActionClick" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                  <TextBlock Text="GPU 互換ブリッジ" Style="{StaticResource SectionHeading}"/>
                  <TextBlock Text="macOS 26.x の共通 ABI に対応する GPU 互換ブリッジを適用・解除します。未対応の ABI や不明なレイアウトは安全に拒否します。" Style="{StaticResource MutedText}"/>
                  <TextBlock x:Name="GuestBridgeStatus" Text="適用状況は未確認です。" Style="{StaticResource MutedText}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                  <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="EnableGuestBridgeButton" Content="GPU 互換ブリッジを適用" Tag="EnableGuestBridge" Click="ActionClick"/>
                    <Button x:Name="DisableGuestBridgeButton" Content="GPU 互換ブリッジを解除" Tag="DisableGuestBridge" Click="ActionClick"/>
                  </WrapPanel>
                  <TextBlock Text="26.4 向け Apple Account 設定（従来）" Style="{StaticResource SectionHeading}"/>
                  <TextBlock Text="Tahoe 26.4 のサインイン互換設定を適用・解除できます。操作前に VM を完全終了してください。" Style="{StaticResource MutedText}"/>
                  <WrapPanel Margin="0,16,0,0">
                    <Button Content="26.4 用の設定を適用" Tag="EnableAppleAccount" Click="ActionClick"/>
                    <Button Content="26.4 用の設定を解除" Tag="DisableAppleAccount" Click="ActionClick"/>
                  </WrapPanel>
                  <TextBlock Text="休止状態は使用しないでください。macOS 更新後は対応確認が必要です。" Style="{StaticResource MutedText}"/>
                  <Button Content="macOS の更新検出を修復" Tag="PrepareUpdates" Click="ActionClick" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="スナップショット">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,28" MaxWidth="680" HorizontalAlignment="Stretch">
                  <TextBlock Text="状態を保存・復元" Style="{StaticResource PageHeading}"/>
                  <TextBlock Text="VM を完全終了してから保存します。復元しても現在のディスクは保持されます。" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="保存する名前" Style="{StaticResource FieldLabel}"/>
                  <DockPanel>
                    <Button Content="保存" DockPanel.Dock="Right" Click="SaveSnapshot" Style="{StaticResource PrimaryButton}" Tag="SnapshotCreate"/>
                    <TextBox x:Name="SnapshotName"/>
                  </DockPanel>
                  <TextBlock Text="保存済みの状態" Style="{StaticResource FieldLabel}"/>
                  <DockPanel>
                    <Button Content="復元…" DockPanel.Dock="Right" Click="RestoreSnapshot" Tag="SnapshotRestore"/>
                    <ComboBox x:Name="Snapshots"/>
                  </DockPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="セットアップ">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,28" MaxWidth="680" HorizontalAlignment="Stretch">
                  <TextBlock Text="macOS をインストール" Style="{StaticResource PageHeading}"/>
                  <TextBlock Text="1  インストーラーを選択" Style="{StaticResource SectionHeading}"/>
                  <DockPanel>
                    <Button Content="ISO を選択…" DockPanel.Dock="Right" Click="BrowseIso"/>
                    <TextBox x:Name="Iso" MinWidth="120" VerticalContentAlignment="Center"/>
                  </DockPanel>
                  <TextBlock Text="2  ディスクを準備" Style="{StaticResource SectionHeading}"/>
                  <TextBlock Text="新規ディスクの容量 (GiB)" Margin="0,0,0,8"/>
                  <TextBox x:Name="NewDiskSize" Text="300" Width="160" HorizontalAlignment="Left"/>
                  <TextBlock Text="3  作成後の動作" Style="{StaticResource SectionHeading}"/>
                  <CheckBox x:Name="StartAfterSetup" IsChecked="True" Content="作成後、インストーラーを起動する" Margin="0,0,0,12"/>
                  <CheckBox x:Name="ConnectIso" Content="インストーラーを接続して起動" Margin="0,0,0,12"/>
                  <TextBlock Text="Disk Utility で仮想ディスクを APFS に初期化し、macOS をインストールします。初回設定後、REIMSTOOLS の setup.command を実行してください。" Style="{StaticResource MutedText}"/>
                  <Button Content="仮想マシンを作成" Click="Setup" HorizontalAlignment="Left" Margin="0,24,0,8" Style="{StaticResource PrimaryButton}" Tag="Setup"/>
                  <Expander Header="エンジンの準備" Margin="0,24,0,0">
                    <WrapPanel Margin="0,12,0,0">
                      <Button Content="WHPX を有効化…" Click="EnableWhpx"/>
                    </WrapPanel>
                  </Expander>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="接続">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,28" MaxWidth="680" HorizontalAlignment="Stretch">
                  <TextBlock Text="macOS とペアリング" Style="{StaticResource PageHeading}"/>
                  <TextBlock Text="Finder の REIMSTOOLS から setup.command を開き、表示されたユーザー名と指紋を入力します。" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="macOS ユーザー名" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="GuestUser"/>
                  <TextBlock Text="SHA256 指紋" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="Fingerprint"/>
                  <Button Content="指紋を照合して接続" Click="Pair" HorizontalAlignment="Left" Margin="0,20,0,16" Style="{StaticResource PrimaryButton}" Tag="Pair"/>
                  <TextBlock Text="macOS のパスワードは保存しません。SSH 鍵はこの VM のフォルダーに保持します。" Style="{StaticResource MutedText}"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="ブリッジ">
              <ScrollViewer x:Name="BridgeScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,28" MaxWidth="680" HorizontalAlignment="Stretch">
                  <TextBlock Text="LAN 接続を準備" Style="{StaticResource PageHeading}"/>
                  <TextBlock Text="接続する Wi-Fi・有線 LAN を選びます。通常のインターネット利用には NAT を使用できます。選択だけでは Windows の接続を変更しません。" Style="{StaticResource MutedText}"/>
                  <TextBlock Text="ホストの接続先" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="Physical" DisplayMemberPath="DisplayName" SelectedValuePath="Id" ToolTip="{Binding SelectedItem.Description, RelativeSource={RelativeSource Self}}" SelectionChanged="WifiSelectionChanged" AutomationProperties.Name="LAN に接続する物理 Wi-Fi・有線 LAN"/>
                  <Button Content="接続先を更新" Click="ReloadNetworkChoices" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                  <Border x:Name="WifiCompatCard" Style="{StaticResource NoticeCard}" Margin="0,16,0,0" Visibility="Collapsed"><StackPanel>
                    <TextBlock Text="Wi-Fi 互換接続（IPv4 / IPv6）" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="専用 TAP を自動で準備します。IPv6 の実際の利用可否はルーター・回線の対応状況にも依存します。" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
                    <TextBlock x:Name="WifiForwarderSummary" Text="転送状態は未確認です" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                    <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="WifiForwarderDetail" Style="{StaticResource MutedText}" Margin="0,6,0,12"/></ScrollViewer>
                    <TextBlock Text="外部ドライバーは非商用の個人・学術用途、商用評価向けです。商用運用・再配布には配布元の別ライセンスが必要です。導入時は Windows 全体の通信が一時的に切れる場合があります。" Style="{StaticResource MutedText}"/>
                    <TextBlock Margin="0,8,0,8"><Hyperlink NavigateUri="https://www.ntkernel.com/windows-packet-filter/download/" RequestNavigate="OpenPacketFilterTerms">配布元の利用条件</Hyperlink><Run Text="  ·  "/><Hyperlink NavigateUri="https://www.ntkernel.com/windows-packet-filter/licensing/" RequestNavigate="OpenPacketFilterTerms">商用ライセンス</Hyperlink></TextBlock>
                    <CheckBox x:Name="PacketFilterTerms" Click="WifiTermsChanged" Margin="0,0,0,12"><TextBlock Text="配布元の個人利用・評価用の利用条件を確認し、同意します（未導入時に必要）。" TextWrapping="Wrap"/></CheckBox>
                    <WrapPanel><Button x:Name="PrepareWifiButton" Content="Wi-Fi 互換接続を準備" Click="PrepareWifi" Tag="PrepareWifi"/><Button x:Name="DisableWifiButton" Content="解除して NAT に戻す" Click="DisableWifi" Tag="DisableWifi"/></WrapPanel>
                  </StackPanel></Border>
                  <StackPanel x:Name="WiredBridgeControls">
                  <TextBlock Text="有線 LAN は Windows ブリッジで接続します。作成時に Windows の通信が一時的に切れる場合があります。" Style="{StaticResource MutedText}"/>
                  <Button x:Name="InstallTapButton" Content="専用 TAP ドライバーを自動導入…" Click="InstallTap" Tag="InstallTap" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                  <TextBlock Text="署名を確認した公式ドライバーを取得します。ブリッジの作成は別の操作です。" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                  <Expander Header="詳細: 既存の専用 TAP を選択" Margin="0,16,0,0"><StackPanel>
                  <TextBlock Text="TAP アダプター" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="BridgeTap"/>
                  <TextBlock Text="他の VPN の TAP を選ばず、Reims 専用のものを明示して選択してください。" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                  </StackPanel></Expander>
                  <Button Content="ブリッジを作成…" Click="CreateBridge" Tag="CreateBridge" HorizontalAlignment="Left" Margin="0,20,0,12"/>
                  <Button x:Name="RemoveBridgeButton" Content="ブリッジを解除して NAT に戻す…" Click="RemoveBridge" Tag="RemoveBridge" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                  <TextBlock Text="Windows の管理者権限が必要です。作成時はネットワーク接続が一時的に切れる場合があります。" Style="{StaticResource MutedText}"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Border>
        <Border x:Name="SettingsFooter" Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
              <TextBlock x:Name="SettingsHint" Text="変更はありません。" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
              <TextBlock Text="接続・共有など、各ページの操作ボタンは即時反映です。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="ReloadHardwareButton" Content="キャンセル" Click="CancelSettings" MinWidth="100" Margin="0,0,8,0"/>
              <Button x:Name="SaveHardwareButton" Content="適用" Click="ApplySettings" MinWidth="90" Margin="0,0,8,0"/>
              <Button x:Name="SettingsOkButton" Content="OK" Click="SaveAndCloseSettings" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
