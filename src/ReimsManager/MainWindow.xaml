<Window x:Class="ReimsManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReimsManager"
 Title="Reims Manager" Width="1280" Height="860" MinWidth="1000" MinHeight="680"
 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable, Yu Gothic UI" FontSize="14"
 PreviewKeyDown="WindowKeyDown">
 <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Menu Padding="12,3">
   <MenuItem Header="ファイル"><MenuItem Header="新しい仮想マシン…" InputGestureText="Ctrl+N" Click="NewVm"/><MenuItem Header="仮想マシンを開く…" InputGestureText="Ctrl+O" Click="OpenVm"/><MenuItem Header="既存のディスクを取り込む…" Click="ImportVm"/><Separator/><MenuItem Header="VM の保存先を開く" Click="RevealVm"/></MenuItem>
   <MenuItem Header="仮想マシン"><MenuItem x:Name="MenuStart" Header="起動" Tag="Start" Click="MenuAction"/><MenuItem x:Name="MenuPowerOff" Header="シャットダウン" Tag="PowerOff" Click="MenuAction"/><MenuItem x:Name="MenuRestart" Header="再起動" Tag="Restart" Click="MenuAction"/><Separator/><MenuItem x:Name="MenuForceExit" Header="強制終了…" Click="ForceExit"/></MenuItem>
   <MenuItem Header="表示"><MenuItem Header="状態を更新" InputGestureText="F5" Click="RefreshClick"/><MenuItem Header="VM 画面を別ウィンドウにする" Click="PopOutConsole"/><MenuItem Header="VM 画面をアプリに戻す" Click="DockConsole"/></MenuItem>
  </Menu>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Padding="16,16,16,12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
    <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="70"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="Reims" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="VIRTUAL MACHINE MANAGER" FontSize="10" Style="{StaticResource MutedText}" Margin="0,3,0,22"/>
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="ライブラリ" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="＋ 新規" Click="NewVm" Grid.Column="1" Padding="10,5" Margin="0" ToolTip="新しい仮想マシン (Ctrl+N)"/></Grid>
      <Grid Margin="0,4,0,8"><TextBox x:Name="LibrarySearch" TextChanged="FilterLibrary" ToolTip="VM の名前で絞り込み" AutomationProperties.Name="仮想マシンを検索"/>
       <TextBlock Text="VM を検索" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=LibrarySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
     </StackPanel>
     <Grid Grid.Row="1" Margin="0,0,0,12">
      <ListBox x:Name="Library" MaxHeight="260" ItemContainerStyle="{StaticResource NavigationItem}" BorderThickness="0" Background="Transparent" SelectionChanged="VmChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="仮想マシン一覧">
       <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,3" ToolTip="{Binding File}"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="19" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="macOS · Reims" FontSize="11" Style="{StaticResource MutedText}" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="LibraryEmpty" Text="「新規」または「開く」から追加" Style="{StaticResource MutedText}" FontSize="12" Margin="10,14" IsHitTestVisible="False"/>
     </Grid>
     <StackPanel Grid.Row="2" x:Name="WorkspaceNavSection" Margin="0,0,0,12">
      <TextBlock Text="選択した VM" Style="{StaticResource Eyebrow}" Margin="12,0,0,6"/>
      <ListBox x:Name="WorkspaceNavigation" ItemContainerStyle="{StaticResource NavigationItem}" BorderThickness="0" Background="Transparent" SelectionChanged="NavigationChanged" AutomationProperties.Name="VM のページ">
       <ListBoxItem Tag="0" Content="コンソール"/><ListBoxItem Tag="1" Content="ハードウェア設定"/><ListBoxItem Tag="2" Content="クリップボード共有"/><ListBoxItem Tag="4" Content="スナップショット"/>
      </ListBox>
      <Button x:Name="AdvancedButton" Content="接続・詳細設定  ▾" Click="ShowPowerMenu" HorizontalContentAlignment="Left" Margin="0,8,0,0" Padding="12,8">
       <Button.ContextMenu><ContextMenu><MenuItem Header="SSH ペアリング" Tag="6" Click="NavigatePage"/><MenuItem Header="OpenCore・Mac の識別情報" Tag="3" Click="NavigatePage"/><MenuItem Header="macOS のインストール" Tag="5" Click="NavigatePage"/><MenuItem Header="ブリッジネットワーク" Tag="7" Click="NavigatePage"/></ContextMenu></Button.ContextMenu>
      </Button>
     </StackPanel>
     <StackPanel Grid.Row="3">
      <Button Content="VM を開く…" Click="OpenVm" HorizontalContentAlignment="Left" Margin="0,0,0,8" ToolTip="Ctrl+O"/>
      <Expander x:Name="EngineSettingsExpander" Header="エンジン設定"><StackPanel Margin="0,10,0,0"><TextBlock x:Name="EngineSummary" Text="未設定" Style="{StaticResource MutedText}"/><TextBox x:Name="Root" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="62" VerticalScrollBarVisibility="Auto" Margin="0,6,0,8" AutomationProperties.Name="エンジンの保存先"/><Button Content="エンジンをセットアップ…" Click="SetupEngine" Margin="0,0,0,6"/><Button x:Name="SelectExistingEngineButton" Content="既存のエンジンを選択…" Click="BrowseRoot" Margin="0"/></StackPanel></Expander>
     </StackPanel>
    </Grid>
    </ScrollViewer>
   </Border>
   <Grid Grid.Column="1" Margin="24,20,24,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="VmTitle" Text="仮想マシン" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="VmSummary" Text="Windows で macOS を管理するワークスペース" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel>
      <Border Grid.Column="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,6" VerticalAlignment="Top" Margin="16,4,0,0"><TextBlock x:Name="State" Text="未選択" FontSize="12" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/></Border>
     </Grid>
     <TextBlock x:Name="StatusDetail" Style="{StaticResource MutedText}" Margin="0,6,0,0" MaxHeight="54" TextTrimming="CharacterEllipsis"/>
     <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <WrapPanel><Button x:Name="StartButton" Content="▶  起動" Tag="Start" Click="ActionClick" Style="{StaticResource PrimaryButton}"/><Button x:Name="ResumeButton" Content="▶  再開" Tag="Resume" Click="ActionClick" Style="{StaticResource PrimaryButton}" Visibility="Collapsed"/><Button x:Name="PowerOffButton" Content="シャットダウン" Tag="PowerOff" Click="ActionClick"/><Button x:Name="RestartButton" Content="再起動" Tag="Restart" Click="ActionClick"/>
       <Button x:Name="PowerMoreButton" Content="•••" ToolTip="その他の電源操作" AutomationProperties.Name="その他の電源操作" Click="ShowPowerMenu"><Button.ContextMenu><ContextMenu><MenuItem Header="完全終了（設定変更前）" Tag="Exit" Click="MenuAction"/><MenuItem Header="一時停止" Tag="Pause" Click="MenuAction"/><MenuItem Header="再開" Tag="Resume" Click="MenuAction"/><Separator/><MenuItem Header="強制終了…" Tag="ForceExit" Click="ForceExit"/></ContextMenu></Button.ContextMenu></Button>
      </WrapPanel>
      <Button x:Name="RefreshButton" Grid.Column="1" Content="更新" Click="RefreshClick" Margin="12,0,0,8" ToolTip="状態を更新 (F5)"/>
     </Grid>
    </StackPanel>
    <StackPanel Grid.Row="1">
     <StackPanel x:Name="OperationProgress" Visibility="Collapsed" Margin="0,0,0,12"><TextBlock x:Name="OperationStatus" Text="処理しています…" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True"/></StackPanel>
     <Border x:Name="EngineNotice" Style="{StaticResource NoticeCard}" Margin="0,0,0,12"><DockPanel><Button Content="セットアップ…" Click="SetupEngine" DockPanel.Dock="Right" Margin="16,0,0,0"/><StackPanel><TextBlock Text="1. Reims エンジンを設定" FontWeight="SemiBold"/><TextBlock Text="最初に一度だけ必要です。設定後に VM を作成・起動できます。" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
     <Border x:Name="Feedback" Visibility="Collapsed" Style="{StaticResource NoticeCard}" Margin="0,0,0,12"><DockPanel><Button Content="閉じる" Click="DismissError" DockPanel.Dock="Right" Margin="16,0,0,0"/><ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ErrorNotice" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></ScrollViewer></DockPanel></Border>
    </StackPanel>
    <ScrollViewer Grid.Row="2" x:Name="Welcome" VerticalScrollBarVisibility="Auto">
     <StackPanel MaxWidth="650" HorizontalAlignment="Left" Margin="8,24,8,20">
      <TextBlock Text="次の macOS を、ここから。" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="インストーラーから作成するか、使っている VM をそのまま開けます。エンジンと VM の保存先は別々に管理します。" Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
      <Button Click="NewVm" Style="{StaticResource WelcomeAction}"><StackPanel><TextBlock Text="新しい仮想マシン" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="名前と保存先を決めて、ISO から macOS をインストール。" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel></Button>
      <Button Click="OpenVm" Style="{StaticResource WelcomeAction}"><StackPanel><TextBlock Text="保存済みの VM を開く" FontSize="18" FontWeight="SemiBold"/><TextBlock Text=".reimsvm ファイルから、前回の環境を続ける。" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel></Button>
      <Button Click="ImportVm" Style="{StaticResource WelcomeAction}"><StackPanel><TextBlock Text="既存ディスクを取り込む" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="VMDK・QCOW2・RAW。元のディスクを変更せずコピーします。" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel></Button>
     </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" x:Name="WorkspaceContent"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="WorkspaceTitle" Text="コンソール" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
     <Border x:Name="WorkspaceSurface" Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
      <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" SelectionChanged="TabChanged">
       <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" KeyboardNavigation.TabNavigation="Local"/></ControlTemplate></TabControl.Template>
<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReimsManager" Header="コンソール"><Grid Margin="0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
       <Grid><ScrollViewer x:Name="ConsolePlaceholder" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470" Margin="24"><TextBlock x:Name="ConsoleSymbol" Text="" FontFamily="Segoe Fluent Icons" FontSize="56" HorizontalAlignment="Center"/><TextBlock Text="ここに VM の画面が表示されます" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,20,0,10" x:Name="ConsoleHeading"/><TextBlock Text="起動すると、このアプリ内で macOS を操作できます。" TextAlignment="Center" Style="{StaticResource MutedText}" x:Name="ConsoleDescription"/><Button Content="VM の画面を接続" Click="DockConsole" HorizontalAlignment="Center" Margin="0,20,0,0" x:Name="ConsoleConnectButton" Tag="Console"/></StackPanel></ScrollViewer>
        <local:VmConsoleHost x:Name="ConsoleView" Visibility="Hidden"/>
       </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="入力の解放: Ctrl + Alt + Win" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
       <Button Grid.Column="1" Content="別ウィンドウで開く" Click="PopOutConsole" Tag="Console" Margin="0"/>
      </Grid>
     </Grid></TabItem>

<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReimsManager" Header="設定"><Grid Margin="0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox ItemContainerStyle="{StaticResource NavigationItem}" x:Name="Devices" SelectionChanged="DeviceChanged" BorderThickness="0" Background="Transparent">
       <ListBoxItem>メモリ</ListBoxItem><ListBoxItem>プロセッサ</ListBoxItem><ListBoxItem>ハードディスク</ListBoxItem><ListBoxItem>CD/DVD・ISO</ListBoxItem><ListBoxItem>ネットワーク</ListBoxItem><ListBoxItem>USB デバイス</ListBoxItem><ListBoxItem>マイク・スピーカー</ListBoxItem><ListBoxItem>ディスプレイ</ListBoxItem>
      </ListBox>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><Grid x:Name="Editors" Margin="0,4,12,16">
       <StackPanel x:Name="MemoryPage"><TextBlock Text="メモリ" Style="{StaticResource PageHeading}"/><TextBlock Text="macOS に割り当てるメモリを選びます。" Style="{StaticResource MutedText}"/><TextBlock Text="割り当て容量 (MiB)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Memory" Text="8192" Width="180" HorizontalAlignment="Left" AutomationProperties.Name="割り当てメモリ MiB"/>
        <Slider x:Name="MemorySlider" Minimum="4" Maximum="128" Value="8" TickFrequency="4" ValueChanged="MemoryChanged" Margin="0,24,0,8" SmallChange="0.00390625" LargeChange="1" ToolTip="4 MiB 単位。入力欄と連動します。"/><DockPanel><TextBlock Text="4 GiB"/><TextBlock Text="128 GiB" TextAlignment="Right"/></DockPanel><TextBlock x:Name="MemoryHint" Style="{StaticResource MutedText}" Margin="0,24,0,0" Text="ホストの空きメモリを残して設定してください。"/></StackPanel>
       <StackPanel x:Name="CpuPage" Visibility="Collapsed"><TextBlock Text="プロセッサ" Style="{StaticResource PageHeading}"/><TextBlock Text="Windows のハードウェア仮想化を使用します。" Style="{StaticResource MutedText}"/><TextBlock Text="CPU コア数" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Cpus" Text="8" Width="180" HorizontalAlignment="Left"/><TextBlock Text="1 ソケット / Windows Hypervisor Platform" Style="{StaticResource MutedText}" Margin="0,24,0,0"/></StackPanel>
       <StackPanel x:Name="DiskPage" Visibility="Collapsed"><TextBlock Text="ハードディスク" Style="{StaticResource PageHeading}"/><TextBlock x:Name="DiskInfo" TextWrapping="Wrap" Margin="0,8,0,16"/><WrapPanel><Button Content="保存先を開く" Click="RevealVm"/><Button Content="ディスク差分を整理" Tag="OptimizeDisk" Click="ActionClick"/></WrapPanel><TextBlock Text="拡張後の容量 (GiB)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DiskSize" Text="128" Width="180" HorizontalAlignment="Left"/><Button Content="容量を拡張…" Click="ExpandDisk" HorizontalAlignment="Left" Margin="0,16,0,8" Tag="ExpandDisk"/><TextBlock Text="拡張後、macOS の Disk Utility でも APFS 領域を拡張します。" Style="{StaticResource MutedText}"/></StackPanel>
       <StackPanel x:Name="MediaPage" Visibility="Collapsed"><TextBlock Text="CD/DVD・ISO" Style="{StaticResource PageHeading}"/><CheckBox x:Name="HardwareIso" Content="起動時にインストーラーを接続" Margin="0,18,0,16"/><TextBox x:Name="HardwareIsoPath" MinWidth="120" VerticalContentAlignment="Center"/><Button Content="ISO を選択…" Click="BrowseHardwareIso" HorizontalAlignment="Left" Margin="0,16,0,8"/><TextBlock Text="インストールが終わったら接続を解除できます。" Style="{StaticResource MutedText}"/></StackPanel>
       <StackPanel x:Name="NetworkPage" Visibility="Collapsed"><TextBlock Text="ネットワーク" Style="{StaticResource PageHeading}"/><RadioButton x:Name="Nat" Content="NAT（通常はこちら）" IsChecked="True" Margin="0,18,0,6"/><TextBlock Text="Windows のインターネット接続を共有します。Apple Account も使用できます。" Style="{StaticResource MutedText}" Margin="24,0,0,20"/><RadioButton x:Name="Bridge" Content="ブリッジ" Margin="0,0,0,6"/><TextBlock Text="VM を LAN 上の独立した機器として接続します。" Style="{StaticResource MutedText}" Margin="24,0,0,8"/><TextBlock Text="TAP アダプター" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Tap"/><TextBlock Text="macOS の IP アドレス / ホスト名" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GuestHost"/><Button Content="ブリッジの準備" Click="OpenBridgeTab" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel>
       <StackPanel x:Name="UsbPage" Visibility="Collapsed"><TextBlock Text="USB デバイス" Style="{StaticResource PageHeading}"/><TextBlock Text="Windows に接続したデバイスを、この VM に接続します。接続中は Windows 側から使用できません。" Style="{StaticResource MutedText}"/><WrapPanel Margin="0,18,0,12"><Button Content="デバイス一覧を更新" Click="RefreshUsb" Tag="ListUsb"/><Button Content="USB 転送ドライバーを導入…" Click="InstallUsbDk"/></WrapPanel><ListBox x:Name="UsbDevices" MinHeight="140" MaxHeight="280" DisplayMemberPath="Label"/><WrapPanel Margin="0,12,0,0"><Button Content="自動接続に登録" Click="AttachUsb" Tag="AttachUsb"/><Button Content="登録を解除して Windows に戻す" Click="DetachUsb" Tag="DetachUsb"/></WrapPanel><TextBlock Text="転送方式（変更は次回起動時）" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="UsbBackend" SelectedIndex="0"><ComboBoxItem>WinUSB（対応する機器）</ComboBoxItem><ComboBoxItem>UsbDk（汎用転送・ドライバー導入後）</ComboBoxItem></ComboBox><TextBlock x:Name="UsbHint" Style="{StaticResource MutedText}" Text="USB 転送には Windows 側の対応ドライバーが必要です。"/></StackPanel>
       <StackPanel x:Name="AudioPage" Visibility="Collapsed"><TextBlock Text="マイク・スピーカー" Style="{StaticResource PageHeading}"/><TextBlock Text="Windows の標準デバイスを macOS と共有します。" Style="{StaticResource MutedText}"/><CheckBox x:Name="Sound" Content="スピーカーを共有" Margin="0,24,0,16"/><CheckBox x:Name="Microphone" Content="マイクを共有" Margin="0,0,0,20"/><TextBlock Text="マイクは macOS のアプリが録音を開始したときに使用します。Windows と macOS の両方でマイクの使用許可を確認してください。" Style="{StaticResource MutedText}"/><Button Content="Windows のサウンド設定" Click="OpenSoundSettings" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel>
       <StackPanel x:Name="DisplayPage" Visibility="Collapsed"><TextBlock Text="ディスプレイ" Style="{StaticResource PageHeading}"/><TextBlock Text="起動時の解像度" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Resolution"><ComboBoxItem>1280x720</ComboBoxItem><ComboBoxItem IsSelected="True">1920x1080</ComboBoxItem><ComboBoxItem>2560x1440</ComboBoxItem><ComboBoxItem>3840x2160</ComboBoxItem></ComboBox><Button Content="実行中の macOS に適用" Click="ApplyResolution" HorizontalAlignment="Left" Margin="0,18,0,0" Tag="ApplyResolution"/><TextBlock Text="macOS 26 の Intel VM では、画面幅が 2048 ピクセルを超えると表示が乱れる既知の問題があります。安定した操作には 1920 × 1080 を推奨します。4K は描画負荷も高くなります。" Style="{StaticResource MutedText}" Margin="0,20,0,0"/><TextBlock Text="Reims vGPU · Apple Paravirtualized Graphics" Style="{StaticResource MutedText}" Margin="0,24,0,0"/></StackPanel>
      </Grid></ScrollViewer>
      <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0"><Button Content="設定を保存" DockPanel.Dock="Right" Click="SaveHardware" Style="{StaticResource PrimaryButton}" x:Name="SaveHardwareButton" Tag="SetHardware"/><Button Content="変更を取り消す" DockPanel.Dock="Right" Click="ReloadHardware" x:Name="ReloadHardwareButton"/><TextBlock Text="変更は VM の完全終了後に保存できます。" Style="{StaticResource MutedText}" VerticalAlignment="Center" x:Name="SettingsHint"/></DockPanel>
     </Grid></TabItem>

<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReimsManager" Header="共有"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,24,24,28" MaxWidth="680" HorizontalAlignment="Left">
      <TextBlock Text="クリップボード" Style="{StaticResource PageHeading}"/><TextBlock Text="Windows と macOS の間でテキストをコピー＆ペーストできます。" Style="{StaticResource MutedText}"/>
      <CheckBox x:Name="ClipboardSharing" Content="テキストを自動で共有する" Checked="ClipboardChanged" Unchecked="ClipboardChanged" Margin="0,24,0,12"/>
      <TextBlock Text="このアプリの起動中、選択した VM と共有します。画像・ファイルは対象外です。" Style="{StaticResource MutedText}"/>
      <WrapPanel Margin="0,24,0,0"><Button Content="Windows → macOS" Click="CopyToGuest" Tag="Clipboard"/><Button Content="macOS → Windows" Click="CopyFromGuest" Tag="Clipboard"/></WrapPanel><TextBlock x:Name="ClipboardStatus" Text="自動共有はオフです。" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
      <TextBlock Text="接続について" Style="{StaticResource SectionHeading}"/><TextBlock Text="共有には SSH のペアリングが必要です。コピー内容をファイルやログには保存しません。" Style="{StaticResource MutedText}"/>
     <Button Content="SSH ペアリングを設定" Tag="6" Click="NavigatePage" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></ScrollViewer></TabItem>

<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReimsManager" Header="OpenCore"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,24,24,28" MaxWidth="680" HorizontalAlignment="Stretch">
      <TextBlock Text="Mac の識別情報" Style="{StaticResource PageHeading}"/><TextBlock Text="Apple Account にログイン済みの場合、識別情報を変更すると再認証が必要になることがあります。" Style="{StaticResource MutedText}"/>
      <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="モデル"/><TextBox x:Name="IdentityModel" Margin="0,6,0,14"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="シリアル番号"/><TextBox x:Name="IdentitySerial" Margin="0,6,0,14"/></StackPanel>
       <StackPanel Grid.Row="1"><TextBlock Text="MLB（ボードシリアル）"/><TextBox x:Name="IdentityMlb" Margin="0,6,0,14"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="ROM（12 桁の16進数）"/><TextBox x:Name="IdentityRom" Margin="0,6,0,14"/></StackPanel>
       <StackPanel Grid.Row="2" Grid.ColumnSpan="3"><TextBlock Text="System UUID"/><TextBox x:Name="IdentityUuid" Margin="0,6,0,0"/></StackPanel>
      </Grid><WrapPanel Margin="0,20,0,0"><Button Content="識別情報を保存" Click="SaveIdentity" Style="{StaticResource PrimaryButton}" Tag="SetIdentity"/><Button Content="現在の設定を読み込む" Click="LoadIdentityClick" Tag="GetIdentity"/><Button Content="新しく生成…" Click="GenerateIdentity" Tag="GenerateIdentity"/></WrapPanel>
      <TextBlock Text="Apple Account" Style="{StaticResource SectionHeading}"/><TextBlock Text="Tahoe 26.4 のサインイン互換設定を適用・解除できます。操作前に VM を完全終了してください。" Style="{StaticResource MutedText}"/><WrapPanel Margin="0,16,0,0"><Button Content="互換設定を適用" Tag="EnableAppleAccount" Click="ActionClick"/><Button Content="互換設定を解除" Tag="DisableAppleAccount" Click="ActionClick"/></WrapPanel>
      <TextBlock Text="休止状態は使用しないでください。macOS 更新後は対応確認が必要です。" Style="{StaticResource MutedText}"/><Button Content="macOS の更新検出を修復" Tag="PrepareUpdates" Click="ActionClick" HorizontalAlignment="Left" Margin="0,18,0,0"/>
     </StackPanel></ScrollViewer></TabItem>

<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReimsManager" Header="スナップショット"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,24,24,28" MaxWidth="680" HorizontalAlignment="Stretch">
      <TextBlock Text="状態を保存・復元" Style="{StaticResource PageHeading}"/><TextBlock Text="VM を完全終了してから保存します。復元しても現在のディスクは保持されます。" Style="{StaticResource MutedText}"/><TextBlock Text="保存する名前" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="保存" DockPanel.Dock="Right" Click="SaveSnapshot" Style="{StaticResource PrimaryButton}" Tag="SnapshotCreate"/><TextBox x:Name="SnapshotName"/></DockPanel><TextBlock Text="保存済みの状態" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="復元…" DockPanel.Dock="Right" Click="RestoreSnapshot" Tag="SnapshotRestore"/><ComboBox x:Name="Snapshots"/></DockPanel>
     </StackPanel></ScrollViewer></TabItem>

<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReimsManager" Header="セットアップ"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,24,24,28" MaxWidth="680" HorizontalAlignment="Stretch">
      <TextBlock Text="macOS をインストール" Style="{StaticResource PageHeading}"/><TextBlock Text="1  インストーラーを選択" Style="{StaticResource SectionHeading}"/><DockPanel><Button Content="ISO を選択…" DockPanel.Dock="Right" Click="BrowseIso"/><TextBox x:Name="Iso" MinWidth="120" VerticalContentAlignment="Center"/></DockPanel><TextBlock Text="2  ディスクを準備" Style="{StaticResource SectionHeading}"/><TextBlock Text="新規ディスクの容量 (GiB)" Margin="0,0,0,8"/><TextBox x:Name="NewDiskSize" Text="128" Width="160" HorizontalAlignment="Left"/><TextBlock Text="3  作成後の動作" Style="{StaticResource SectionHeading}"/><CheckBox x:Name="StartAfterSetup" IsChecked="True" Content="作成後、インストーラーを起動する" Margin="0,0,0,12"/><CheckBox x:Name="ConnectIso" Content="インストーラーを接続して起動" Margin="0,0,0,12"/><TextBlock Text="Disk Utility で仮想ディスクを APFS に初期化し、macOS をインストールします。初回設定後、REIMSTOOLS の setup.command を実行してください。" Style="{StaticResource MutedText}"/>
      <Button Content="仮想マシンを作成" Click="Setup" HorizontalAlignment="Left" Margin="0,24,0,8" Style="{StaticResource PrimaryButton}" Tag="Setup"/>
      <Expander Header="エンジンの準備" Margin="0,24,0,0"><WrapPanel Margin="0,12,0,0"><Button Content="WHPX を有効化…" Click="EnableWhpx"/></WrapPanel></Expander>
     </StackPanel></ScrollViewer></TabItem>

<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReimsManager" Header="接続"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,24,24,28" MaxWidth="680" HorizontalAlignment="Stretch">
      <TextBlock Text="macOS とペアリング" Style="{StaticResource PageHeading}"/><TextBlock Text="Finder の REIMSTOOLS から setup.command を開き、表示されたユーザー名と指紋を入力します。" Style="{StaticResource MutedText}"/><TextBlock Text="macOS ユーザー名" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GuestUser"/><TextBlock Text="SHA256 指紋" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Fingerprint"/><Button Content="指紋を照合して接続" Click="Pair" HorizontalAlignment="Left" Margin="0,20,0,16" Style="{StaticResource PrimaryButton}" Tag="Pair"/><TextBlock Text="macOS のパスワードは保存しません。SSH 鍵はこの VM のフォルダーに保持します。" Style="{StaticResource MutedText}"/>
     </StackPanel></ScrollViewer></TabItem>

<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReimsManager" Header="ブリッジ"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,24,24,28" MaxWidth="680" HorizontalAlignment="Stretch">
      <TextBlock Text="ブリッジ接続を準備" Style="{StaticResource PageHeading}"/><TextBlock Text="TAP-Windows6 と物理アダプターを接続します。通常のインターネット利用には NAT を使用できます。" Style="{StaticResource MutedText}"/><WrapPanel Margin="0,20,0,0"><Button Content="TAP をダウンロード" Click="TapDownload"/><Button Content="署名済み TAP を導入…" Click="InstallTap"/></WrapPanel><TextBlock Text="TAP アダプター" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="BridgeTap"/><TextBlock Text="物理アダプター" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Physical"/><Button Content="ブリッジを作成…" Click="CreateBridge" HorizontalAlignment="Left" Margin="0,20,0,12"/><TextBlock Text="Windows の管理者権限が必要です。作成時はネットワーク接続が一時的に切れる場合があります。" Style="{StaticResource MutedText}"/>
     </StackPanel></ScrollViewer></TabItem>

      </TabControl>
     </Border>
    </Grid>
    <Expander x:Name="OperationLog" Header="操作ログ" Grid.Row="3" Margin="0,12,0,0"><DockPanel Margin="0,8,0,0"><StackPanel DockPanel.Dock="Right" Margin="12,0,0,0"><Button Content="診断ログを保存" Tag="CollectLogs" Click="ActionClick" Margin="0,0,0,8"/><Button Content="表示をクリア" Click="ClearLog" Margin="0"/></StackPanel><TextBox x:Name="Log" Height="120" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" AutomationProperties.Name="操作ログ"/></DockPanel></Expander>
   </Grid>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="18,8"><DockPanel><Button x:Name="RevealButton" Content="保存先を開く" Click="RevealVm" DockPanel.Dock="Right" Padding="10,2" Margin="12,0,0,0"/><TextBlock x:Name="VmLocation" Text="VM ファイルを開くか、新規作成してください。" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center"/></DockPanel></Border>
 </Grid>
</Window>
