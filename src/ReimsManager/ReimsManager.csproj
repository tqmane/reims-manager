<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ReimsManager</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../backend/*.ps1" Link="scripts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../backend/*.json" Link="scripts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../backend/opencore/*.py" Link="scripts/opencore/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../backend/ucrt64.cmake" Link="scripts/ucrt64.cmake" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../backend/guest-setup.command" Link="scripts/guest-setup.command" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../backend/guest-display.js" Link="scripts/guest-display.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
