<Window x:Class="ReimsManager.NewVmWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="macOS をセットアップ" Width="760" Height="760" MinWidth="650" MinHeight="650"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable, Yu Gothic UI" FontSize="14">
 <Grid Background="{DynamicResource ApplicationBackgroundBrush}"><Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock x:Name="StepTitle" Text="2 / 3  Windows の準備" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock x:Name="StepHint" Text="必須の項目を確認します。USB・ブリッジ接続の準備は後からでも行えます。" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.75"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <DockPanel x:Name="RequirementsPage">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
     <TextBlock x:Name="RequirementsSummary" Text="必要な機能を確認しています…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <WrapPanel Margin="0,12,0,0">
      <Button x:Name="RefreshRequirementsButton" Content="再確認" Click="RefreshRequirementsClick" Margin="0,0,8,8"/>
      <Button x:Name="EnableWhpxButton" Content="WHPX を有効にする（管理者）" Tag="EnableWhpx" Click="RepairRequirement" Visibility="Collapsed" Margin="0,0,8,8"/>
      <Button x:Name="InstallUsbButton" Content="USB ドライバーを導入（任意）" Tag="InstallUsbDk" Click="RepairRequirement" Visibility="Collapsed" Margin="0,0,8,8"/>
     </WrapPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="RequirementsList"><ItemsControl.ItemTemplate><DataTemplate>
     <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Message}" Margin="0,5,0,0" TextWrapping="Wrap" Opacity="0.75"/></StackPanel>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </DockPanel>
   <ScrollViewer x:Name="VmPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="macOS インストーラー (ISO / IMG)" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <DockPanel><Button Content="参照…" Click="BrowseInstaller" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="Installer" AutomationProperties.Name="インストーラー"/></DockPanel>
     <TextBlock Text="仮想マシンの名前" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VmName" Text="macOS Tahoe" TextChanged="LocationChanged" AutomationProperties.Name="仮想マシンの名前"/>
     <TextBlock Text="保存先の親フォルダー" Style="{StaticResource FieldLabel}"/>
     <DockPanel><Button Content="参照…" Click="BrowseFolder" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="ParentFolder" TextChanged="LocationChanged" AutomationProperties.Name="VM の親フォルダー"/></DockPanel>
     <TextBlock x:Name="LocationPreview" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75"/>
     <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="ディスク (GiB)" Margin="0,0,0,8"/><TextBox x:Name="Capacity" Text="300" AutomationProperties.Name="仮想ディスク容量 GiB"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="CPU (vCPU)" Margin="0,0,0,8"/><TextBox x:Name="CpuCount" Text="4" AutomationProperties.Name="CPU 数"/></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Text="メモリ (MiB)" Margin="0,0,0,8"/><TextBox x:Name="MemorySize" Text="4096" AutomationProperties.Name="メモリ MiB"/></StackPanel>
     </Grid>
     <Button Content="割り当てを再確認" Click="RefreshRequirementsClick" HorizontalAlignment="Left" Margin="0,12,0,0"/>
     <TextBlock Text="仮想ディスクは使用量に応じて増えます。選んだフォルダーの中に VM ごとのフォルダーを作成します。" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.75"/>
     <TextBlock x:Name="MemoryPlan" TextWrapping="Wrap" Margin="0,20,0,8" AutomationProperties.LiveSetting="Polite"/>
     <CheckBox x:Name="StartAfterCreation" Content="準備ができたらインストーラーを起動する" IsChecked="True" Margin="0,8,0,0"/>
     <TextBlock Text="QEMU・OpenCore・OVMF・GPU ROM・ゲスト用アドオンを自動で準備します。macOS のインストールと初回設定は VM の画面で行ってください。" TextWrapping="Wrap" Margin="0,16,0,0" Opacity="0.75"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,16,0,0"><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="Notice" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
  <Grid Grid.Row="3" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="BackButton" Content="必要条件に戻る" Click="Back" HorizontalAlignment="Left" Visibility="Collapsed"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelButton" Content="キャンセル" Click="Cancel" Margin="0,0,8,0"/>
    <Button x:Name="NextButton" Content="インストーラーを選ぶ" Click="Next" IsEnabled="False" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0"/>
    <Button x:Name="CreateButton" Content="仮想マシンを作成" Click="Create" Visibility="Collapsed" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0"/>
   </StackPanel>
  </Grid>
 </Grid></Grid>
</Window>
